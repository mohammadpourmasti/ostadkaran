# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL, used for metadata, robots.txt and sitemap.xml (no trailing slash).
# Optional on Vercel production: falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public values (safe to expose to the browser; access is enforced by RLS).
# Use the publishable key (sb_publishable_...) or the legacy anon key.
# Never put the service-role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
