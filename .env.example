# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL, used for metadata, robots.txt and sitemap.xml (no trailing slash).
# Optional on Vercel production: falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (public; used by the server-side client too).
NEXT_PUBLIC_SUPABASE_URL=

# SERVER-ONLY secret key (sb_secret_...). Bypasses RLS and is used only by the repair request Server Action.
# NEVER prefix it with NEXT_PUBLIC_, never import it into a Client Component, never commit a real value.
SUPABASE_SECRET_KEY=

# Supabase PUBLISHABLE (anon) key for the admin dashboard sign-in session. Safe for the browser; NOT the secret key.
# The dashboard never uses SUPABASE_SECRET_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SMS (FUTURE; nothing is connected or sent today) ---
# Server-only. Never prefix with NEXT_PUBLIC_. See docs/sms-integration.md.
# SMS_ENABLED=true only takes effect once a provider adapter is registered in lib/sms/providers/index.ts.
SMS_ENABLED=false
SMS_PROVIDER=
# Read by the provider adapter you add later (names are examples; use what your provider needs):
SMS_API_KEY=
SMS_SENDER_NUMBER=

# --- Repair-request anti-spam ---
# TRUSTED_IP_HEADER: the NAME of the one HTTP header that your infrastructure sets to the visitor's real IP.
# Allowed values (anything else is ignored):
#   cf-connecting-ip   when the site is behind Cloudflare
#   x-real-ip          when it is behind nginx with:  proxy_set_header X-Real-IP $remote_addr;
# Leave it empty on Vercel/local development: per-IP limits are then DISABLED (a warning is logged once);
# the per-phone limit in the database and the form token still apply.
# Set it ONLY if the app can be reached solely through that proxy. If visitors can hit the origin directly they
# can forge the header and dodge the per-IP limits. "x-forwarded-for" is deliberately not supported because its
# first entry is chosen by the client.
TRUSTED_IP_HEADER=
