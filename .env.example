# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL, used for metadata, robots.txt and sitemap.xml (no trailing slash).
# Optional on Vercel production: falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (public; used by the server-side client too).
NEXT_PUBLIC_SUPABASE_URL=

# SERVER-ONLY secret key (sb_secret_...). Bypasses RLS and is used only by the repair request Server Action.
# NEVER prefix it with NEXT_PUBLIC_, never import it into a Client Component, never commit a real value.
SUPABASE_SECRET_KEY=

# Supabase PUBLISHABLE (anon) key for the admin dashboard sign-in session. Safe for the browser; NOT the secret key.
# The dashboard never uses SUPABASE_SECRET_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SMS (FUTURE; nothing is connected or sent today) ---
# Server-only. Never prefix with NEXT_PUBLIC_. See docs/sms-integration.md.
# SMS_ENABLED=true only takes effect once a provider adapter is registered in lib/sms/providers/index.ts.
SMS_ENABLED=false
SMS_PROVIDER=
# Read by the provider adapter you add later (names are examples; use what your provider needs):
SMS_API_KEY=
SMS_SENDER_NUMBER=

# --- Repair-request anti-spam ---
# Server-only. Name of the ONE header your infrastructure sets to the visitor's real IP: "cf-connecting-ip"
# (behind Cloudflare) or "x-real-ip" (nginx: proxy_set_header X-Real-IP $remote_addr). Only set it if the origin
# is reachable only through that proxy; any other header name is ignored. Empty = per-IP limits are disabled.
TRUSTED_IP_HEADER=
